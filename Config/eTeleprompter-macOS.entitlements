<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Mac App Store requires App Sandbox. eTeleprompter has no
	     networking and keeps its scripts in its own container via SwiftData. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Import reads a file the user picks in the open panel. Without this the
	     panel still opens (it runs out of process) but the app is never
	     granted access to the chosen file, so the import silently does
	     nothing. Read-only is sufficient: imported text is copied into the
	     script and the original file is never written. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
</dict>
</plist>
